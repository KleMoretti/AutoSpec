{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospec://contracts/execution-bundle-v1",
  "title": "AutoSpec Execution Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_version", "workflow_key", "workflow_version", "workflow_spec_hash", "protocol_version", "nodes"],
  "properties": {
    "schema_version": {"type": "string", "const": "execution-bundle-v1"},
    "bundle_version": {"type": "string", "minLength": 1},
    "workflow_key": {"type": "string", "minLength": 1},
    "workflow_version": {"type": "string", "minLength": 1},
    "workflow_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_version": {"type": "integer", "minimum": 0, "maximum": 2},
    "runtime": {"type": "object", "additionalProperties": {"type": "integer"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "allOf": [
    {
      "if": {"properties": {"protocol_version": {"minimum": 1}}},
      "then": {
        "properties": {
          "nodes": {"items": {"required": ["input_schema", "output_schema", "artifact_type"]}}
        }
      }
    }
  ],
  "$defs": {
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "checksum", "content"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "handler_key", "handler_version"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "handler_key": {"type": "string", "minLength": 1},
        "handler_version": {"type": "string", "minLength": 1},
        "input_schema": {"type": ["string", "null"], "minLength": 1},
        "input_schema_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "output_schema": {"type": ["string", "null"], "minLength": 1},
        "output_schema_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "artifact_type": {"type": ["string", "null"], "minLength": 1},
        "prompt_key": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "prompt_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "prompt": {"anyOf": [{"$ref": "#/$defs/prompt"}, {"type": "null"}]},
        "context_policy": {"type": "object"},
        "model_policy": {"type": "object"},
        "retry_policy": {"type": "object"},
        "fallback": {"type": "object"},
        "tool_policy": {"type": "object"},
        "agent_loop_policy": {"type": "object"},
        "retrieval_policy": {"type": "object"}
      }
    }
  }
}
