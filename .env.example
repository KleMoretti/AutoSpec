DB_HOST=localhost
DB_PORT=3306
MYSQL_DATABASE=autospec
MYSQL_USER=autospec
MYSQL_PASSWORD=your_local_mysql_password
MYSQL_ROOT_PASSWORD=your_local_mysql_root_password
DB_SSL_MODE=DISABLED
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
AGENT_ENGINE_SERVICE_TOKEN=replace-with-a-long-random-local-token
AUTOSPEC_ENV=development
AGENT_MODEL_MODE=fixture
# Live mode requires MODEL_API_KEY, MODEL_BASE_URL, and MODEL_NAME.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_PROVIDER_KEY=openai-compatible
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
MODEL_INPUT_COST_PER_1M=0
MODEL_OUTPUT_COST_PER_1M=0
# Optional quality routes inherit the base API key/base URL when only a model is set.
MODEL_FAST_NAME=
MODEL_FAST_PROVIDER_KEY=
MODEL_FAST_INPUT_COST_PER_1M=0
MODEL_FAST_OUTPUT_COST_PER_1M=0
MODEL_DEEP_NAME=
MODEL_DEEP_PROVIDER_KEY=
MODEL_DEEP_INPUT_COST_PER_1M=0
MODEL_DEEP_OUTPUT_COST_PER_1M=0
# Optional one-shot fallback for transient timeout/rate-limit/provider failures.
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_NAME=
MODEL_FALLBACK_PROVIDER_KEY=
MODEL_FALLBACK_INPUT_COST_PER_1M=0
MODEL_FALLBACK_OUTPUT_COST_PER_1M=0
AUTH_DEMO_USER_ENABLED=true
AUTH_DEMO_USER_USERNAME=owner
AUTH_DEMO_USER_DISPLAY_NAME=Owner
AUTH_DEMO_USER_PASSWORD=replace-with-a-local-demo-password
AUTH_SESSION_TTL=12h
AUTH_SESSION_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW=5m
BACKEND_TRACING_ENABLED=false
BACKEND_TRACING_SAMPLING_PROBABILITY=1.0
BACKEND_OTLP_TRACING_TIMEOUT=5s

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_SSL_ENABLED=false
WORKFLOW_BACKLOG_METRICS_ENABLED=false
WORKFLOW_BACKLOG_METRICS_FIXED_DELAY=15000
WORKFLOW_BACKLOG_METRICS_INITIAL_DELAY=5000
WORKFLOW_ADMISSION_ENABLED=true
WORKFLOW_ADMISSION_MAX_PENDING_OUTBOX=10000
WORKFLOW_ADMISSION_MAX_OLDEST_OUTBOX_AGE=5m
WORKFLOW_ADMISSION_MAX_WORKER_BACKLOG=1000
WORKFLOW_ADMISSION_RETRY_AFTER=5s
WORKFLOW_EVENT_POLLING_ENABLED=false
WORKFLOW_EVENT_CONSUMER_NAME=control-plane
WORKFLOW_EVENT_BATCH_SIZE=10
WORKER_BATCH_SIZE=1
WORKFLOW_EVENT_BLOCK_TIMEOUT=1s
WORKFLOW_EVENT_FIXED_DELAY=1000
WORKFLOW_EVENT_INITIAL_DELAY=1000
WORKFLOW_COMMAND_STREAM_MAX_LENGTH=1000000
WORKFLOW_EVENT_STREAM_MAX_LENGTH=1000000
WORKFLOW_COMMAND_DLQ_MAX_LENGTH=100000
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9100
WORKER_TRACING_ENABLED=false
OTEL_SERVICE_NAME=autospec-agent-worker
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5
WORKFLOW_OUTBOX_ENABLED=false
WORKFLOW_OUTBOX_BATCH_SIZE=20
WORKFLOW_OUTBOX_FIXED_DELAY=500
WORKFLOW_OUTBOX_INITIAL_DELAY=1000
WORKFLOW_OUTBOX_RETRY_MAX_ATTEMPTS=5
WORKFLOW_RECOVERY_ENABLED=false
WORKFLOW_RECOVERY_LEASE_TIMEOUT=30s
WORKFLOW_RECOVERY_FIXED_DELAY=5000
WORKFLOW_RECOVERY_INITIAL_DELAY=5000
KNOWLEDGE_INDEX_RECOVERY_ENABLED=false
KNOWLEDGE_INDEX_RECOVERY_BATCH_SIZE=20
KNOWLEDGE_INDEX_RECOVERY_FIXED_DELAY=60000
KNOWLEDGE_INDEX_RECOVERY_INITIAL_DELAY=30000
